# /opt/cc-remote/.env  (ON THE VPS)
# Generate each secret with:  openssl rand -hex 32
# setup-vps.sh rejects placeholders, LOGIN_PASSWORD shorter than 16 characters,
# and SESSION_SECRET / WRAPPER_TOKEN shorter than 32 characters.
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# To add direct LAN/Tailscale IPv4 access alongside the public Caddy origin,
# set this to 1 and RELAY_HOST to 0.0.0.0. Port 8765 then listens on every IPv4
# interface; restrict it to trusted private peers with the host firewall.
ALLOW_PRIVATE_ORIGINS=0
# Exact browser origin allowed to open a cookie-authenticated WebSocket.
PUBLIC_ORIGIN=https://cc-remote.example.com
# Extra peers allowed to set X-Forwarded-Proto / X-Forwarded-For, on top of the
# built-in loopback defaults. Only needed when Caddy/nginx does not reach the
# relay over loopback (Tailscale, LAN, or the Docker bridge gateway); without
# it uvicorn ignores the proxy headers and every WebSocket is rejected with 403
# while /api/* keeps working. List ONLY your own proxy's addresses -- a trusted
# peer can claim any client IP and any scheme, so the relay must not be
# reachable from anywhere else. Never "*".
# FORWARDED_ALLOW_IPS=100.64.0.9,fd7a:115c:a1e0::1
# Default: bridge (same-origin transport, opaque sandbox; no extra DNS/TLS).
# No directory is published automatically. off disables viewing.
# An existing explicit origin template selects isolated when mode is unset.
# VIEWER_MODE=bridge
# Optional isolated mode needs DNS/TLS/CSP first. See docs/remote-viewer.md.
# VIEWER_ORIGIN_TEMPLATE=https://{id}.preview.example.com
# Leave at 0 for the normal domain + TLS path. Set to 1 only for the supported
# public-IPv4 escape hatch, change PUBLIC_ORIGIN to http://your-public-ip, and
# pass the same IP to setup-vps.sh. Caddy will listen on plain port 80; the
# login password, session cookie, and all traffic travel in cleartext.
ALLOW_INSECURE_HTTP=0
# Web login password (what you type in the browser to log in). REQUIRED.
LOGIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Optional multi-user replacement for LOGIN_PASSWORD. Leave commented for a
# single-user relay. Passwords must be at least 12 characters.
# LOGIN_USERS_JSON='{"alice":{"password":"REPLACE_WITH_A_STRONG_PASSWORD","machines":["nono"]}}'
# HMAC secret for signing web session tokens. REQUIRED.
SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
# Must match the wrapper's WRAPPER_TOKEN.
WRAPPER_TOKEN=REPLACE_WITH_STRONG_WRAPPER_TOKEN
# Optional machine-bound replacement for the wildcard WRAPPER_TOKEN. Each
# wrapper gets the matching token through its local WRAPPER_TOKEN variable.
# WRAPPER_TOKENS_JSON='{"nono":"REPLACE_WITH_STRONG_NONO_TOKEN"}'
# Built web client in the atomically selected immutable release.
WEB_STATIC_DIR=/opt/cc-remote/current/web/dist
SESSION_TTL_SECONDS=604800
LOGIN_BODY_MAX_BYTES=4096
LOGIN_READ_TIMEOUT=10
LOGIN_INFLIGHT_CAP=32
SESSION_REGISTRY_CAP=1024
# Optional durable Web Push completion notifications. Configure all three
# VAPID values; keep the private key readable only by the relay service user.
# PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
# PUSH_VAPID_PRIVATE_KEY=/opt/cc-remote/secrets/vapid-private.pem
# PUSH_VAPID_SUBJECT=mailto:admin@example.com
PUSH_DB_PATH=/opt/cc-remote/state/relay-push.sqlite3
DEVICE_DB_PATH=/opt/cc-remote/state/relay-devices.sqlite3
DEVICE_PAIRING_TTL_SECONDS=600
CLIENT_QUEUE_CAP=4096
CLIENT_QUEUE_BYTES=16777216
MAX_CLIENTS=8
CLIENT_HELLO_TIMEOUT=10
WS_MAX_SIZE_BYTES=16777216
LOG_LEVEL=INFO
