[Unit]
Description=cc-remote wrapper (drives local Claude Code, dials the relay over wss)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User + the repository/home paths below to match the account that runs Claude Code.
User=youruser
WorkingDirectory=/path/to/cc-remote
# systemd reads this as root before dropping privileges. Keep it root:root 0600;
# the service and all model/tool descendants are then denied the source file.
EnvironmentFile=/etc/cc-remote/wrapper.env
# Optional credential created by `python -m cc_remote.device pair --env-file`.
# It is loaded after wrapper.env so a paired machine can replace the legacy
# relay token/id without editing the rest of the service configuration.
EnvironmentFile=-/etc/cc-remote/device.env
Environment=PYTHON_DOTENV_DISABLED=1
InaccessiblePaths=/etc/cc-remote -/path/to/cc-remote/.env
# Prefer an absolute CLAUDE_BIN in the EnvironmentFile. PATH remains the
# backwards-compatible fallback and is also inherited by Claude's child tools.
Environment="PATH=/home/youruser/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/path/to/cc-remote/.venv/bin/python -I -B /path/to/cc-remote/deploy/wrapper_main.py
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
