# cc-remote local/loopback .env — relay + wrapper share this file.
# Do not use it as the production wrapper secret store: model tools can read
# normal user files. See README for root-only /etc/cc-remote/wrapper.env.
# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# ---- Relay: web login + wrapper auth ----
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# Exact browser origin allowed for cookie-authenticated WebSockets. Plain HTTP
# is accepted only on loopback; production must use https://.
PUBLIC_ORIGIN=http://127.0.0.1:8765
# Extra peers allowed to set X-Forwarded-Proto / X-Forwarded-For, on top of the
# built-in 127.0.0.1 and ::1. Needed only when your reverse proxy reaches the
# relay from a non-loopback address (Tailscale, LAN, Docker bridge gateway);
# otherwise uvicorn ignores the proxy headers, the relay computes an http
# request target while the browser Origin is https, and every WebSocket is
# rejected with 403 even though the page and /api/* work. List ONLY the
# addresses that proxy connects from: a trusted peer may claim any client IP
# and any scheme, so keep direct access to the relay restricted. Never "*".
# FORWARDED_ALLOW_IPS=100.64.0.9,fd7a:115c:a1e0::1
# Optional direct browser access through literal private/loopback IPs on
# RELAY_PORT. Covers 127/8, 10/8, 172.16/12, 192.168/16, Tailscale's
# 100.64/10, IPv6 loopback and ULA. Hostnames, public IPs and other ports stay
# rejected. Plain HTTP still exposes the password, cookie and traffic to the
# local network, and it cannot provide an installable PWA.
ALLOW_PRIVATE_ORIGINS=0
# Opt-in escape hatch: set to 1 to allow PUBLIC_ORIGIN/RELAY_URL to be a
# non-loopback plain http://IP (or ws://IP) instead of requiring https/wss —
# e.g. reaching the relay over a bare public IP with no TLS terminator in
# front. Leave unset/0 unless you understand the tradeoff: the login
# password, session cookie, and all traffic travel in cleartext, so anyone on
# the network path can read or hijack the session. Prefer TLS (Caddy/nginx,
# see deploy/) whenever possible.
ALLOW_INSECURE_HTTP=0
# Web login password (what you type in the browser). REQUIRED.
LOGIN_PASSWORD=change-me-login
# Optional multi-user replacement for LOGIN_PASSWORD. Each account sees only
# its allowed machines. Keep commented for the normal single-user setup.
# LOGIN_USERS_JSON='{"alice":{"password":"change-me-long-password","machines":["mac","nono"]}}'
# HMAC secret for signing web session tokens. REQUIRED.
SESSION_SECRET=change-me-openssl-rand-hex-32
# Shared token between wrapper and relay (must match on both).
WRAPPER_TOKEN=change-me-wrapper
# Optional relay-side replacement for WRAPPER_TOKEN. Every wrapper continues to
# receive its own matching value through WRAPPER_TOKEN.
# WRAPPER_TOKENS_JSON='{"mac":"change-me-long-machine-token","nono":"change-me-another-machine-token"}'
# Serve the built web client (web/dist) from the relay, same origin.
WEB_STATIC_DIR=web/dist
SESSION_TTL_SECONDS=604800
LOGIN_BODY_MAX_BYTES=4096
LOGIN_READ_TIMEOUT=10
LOGIN_INFLIGHT_CAP=32
SESSION_REGISTRY_CAP=1024

# Optional real Web Push completion notifications. Generate one VAPID key pair
# for the relay, keep the private key outside git, and configure all three.
# PUSH_VAPID_PUBLIC_KEY=<url-safe-base64-public-key>
# PUSH_VAPID_PRIVATE_KEY=/absolute/path/to/vapid-private.pem
# PUSH_VAPID_SUBJECT=mailto:admin@example.com
# PUSH_DB_PATH=~/.cc-remote/relay-push.sqlite3
# Device enrollment registry stores metadata and credential hashes only.
# DEVICE_DB_PATH=~/.cc-remote/relay-devices.sqlite3
DEVICE_PAIRING_TTL_SECONDS=600

# Hard per-browser forwarding queue limits. A client that cannot keep up is
# disconnected and reconnects; frames are never silently dropped.
CLIENT_QUEUE_CAP=4096
CLIENT_QUEUE_BYTES=16777216
MAX_CLIENTS=8
CLIENT_HELLO_TIMEOUT=10
# Maximum decoded inbound WebSocket frame on relay and wrapper transports.
WS_MAX_SIZE_BYTES=16777216

# ---- Wrapper ----
RELAY_URL=ws://127.0.0.1:8765/ws
# Same ALLOW_INSECURE_HTTP switch as above; the wrapper reads it too so
# RELAY_URL can stay ws:// against a non-loopback host.
# Stable route id when multiple wrapper machines share this relay.
CC_REMOTE_MACHINE_ID=default
# Use the same rolling Claude Code install as the user's normal shell. Override
# only with another explicit executable; empty still resolves to this path.
CLAUDE_BIN=~/.local/bin/claude
# Optional user-defined Claude account registry. Each config_dir is one complete
# CLAUDE_CONFIG_DIR; exactly one entry is default. Empty keeps single-account
# behavior. Explicit profiles load only their selected user settings, while
# Claude still discovers project CLAUDE.md, rules, and skills. Prefer
# CC_REMOTE_CLAUDE_PROFILES_FILE for private local config.
# CC_REMOTE_CLAUDE_PROFILES_JSON='{"personal":{"label":"Personal","config_dir":"/home/youruser/.claude","default":true},"company":{"label":"Company","config_dir":"/home/youruser/.claude-company"}}'
# CC_REMOTE_CLAUDE_PROFILES_FILE=/home/youruser/.cc-remote/claude-profiles.json
# Optional proxy for wrapper-owned Codex subprocesses only. It does not alter
# the wrapper connection or any `codex` command launched from your shell.
CC_REMOTE_CODEX_PROXY=
# Unix socket shared by the wrapper and explicit `claude-remote` launcher.
# The launcher does not read this dotenv file, so export the same value in its
# shell. It never replaces or aliases the official `claude` command.
CC_REMOTE_CLAUDE_BROKER_SOCKET=~/.cc-remote/claude-broker.sock
# Code prefers the official shared Codex daemon; off forces private stdio for
# troubleshooting. Codex Work is always private regardless of this setting.
CC_REMOTE_CODEX_DAEMON=auto
# Optional user-defined Codex account registry. Each home is one complete
# CODEX_HOME; exactly one entry is default.
# CC_REMOTE_CODEX_PROFILES_JSON='{"personal":{"label":"Personal","home":"/home/youruser/.codex","default":true},"company":{"label":"Company","home":"/home/youruser/.codex-company"}}'
# CC_REMOTE_CODEX_PROFILES_FILE=/home/youruser/.cc-remote/codex-profiles.json
# Working directory of the claude session. MUST match for --resume to find the
# session jsonl under ~/.claude/projects/.
CC_CWD=/path/to/your/project
# Resume a specific session UUID; blank = fresh session. The id is persisted to
# ~/.cc-remote/ after first start.
CC_RESUME_SESSION_ID=
# Work/Cowork private roots. The defaults keep Claude and Codex data separated
# under their own provider directories; normally you should not change these.
CLAUDE_WORK_ROOT=~/.claude/cc-remote/work
CODEX_WORK_ROOT=~/.codex/cc-remote/work

# ---- Wrapper tuning (optional) ----
MAX_CONCURRENT_SESSIONS=20
DRAIN_TIMEOUT=15
# Non-terminal warning after this many seconds without any Codex app-server
# event. 0 disables; it never auto-interrupts a valid long-running turn.
CODEX_TURN_IDLE_WARN_SECONDS=90
RING_MAX_EVENTS=2000
RING_MAX_BYTES=25165824
TOOL_RESULT_MAX=65536
HISTORY_SOURCE_MAX_BYTES=67108864
CODEX_HISTORY_WINDOW_MAX_BYTES=33554432
WRAPPER_INBOX_CAP=1024
WRAPPER_SEND_QUEUE_CAP=8192
WRAPPER_INBOX_BYTES=33554432
WRAPPER_SEND_QUEUE_BYTES=33554432
TURN_READER_QUEUE_CAP=4

# ---- Logging ----
LOG_LEVEL=INFO
